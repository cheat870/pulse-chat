PORT=5000
JWT_SECRET=pulsechat_super_secret_key_2026_jwt_token
CLIENT_URL=https://pulse-chat-two-sigma.vercel.app
NODE_ENV=production

# ── TURSO CLOUD SQLITE (Permanent Database Storage) ─────────────────────
# Create free DB at https://turso.tech -> turso db create pulsechat
TURSO_DATABASE_URL=libsql://your-database-slug.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── CLOUDFLARE R2 (Permanent Media & File Storage) ──────────────────────
# Create free bucket at https://dash.cloudflare.com -> R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pulsechat-media
# R2_PUBLIC_DOMAIN can be your custom domain or pub-xxx.r2.dev public URL
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# ── WEB PUSH (VAPID Keys) ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@pulsechat.app
